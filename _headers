# Cloudflare Pages 读这个文件（GitHub Pages 不管它）。
# 这个小游戏不需要被搜索引擎和 AI 爬虫收录：每个文件都带 noindex（Google、Bing 读得到它，见 robots.txt）
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

# 首页和离线缓存脚本每次都问一下有没有新版本
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
# 闯关游戏各自文件夹里的代码（schulte/game.js、dots/game.css……）要和首页同一个版本
/:game/game.js
  Cache-Control: no-cache
/:game/game.css
  Cache-Control: no-cache

# 语音包：页面按 ?h=内容指纹 去取，内容一变网址就变，可以放心长缓存
/voice-zh.bin
  Cache-Control: public, max-age=31536000, immutable
/pattern/voice-gl.bin
  Cache-Control: public, max-age=31536000, immutable
/shi/voice-shi.bin
  Cache-Control: public, max-age=31536000, immutable
